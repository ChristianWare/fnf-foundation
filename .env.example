# ─────────────────────────────────────────────────────────────────────────────
#  Copy to .env and fill in. Never commit .env.
#  Brand values (name, phone, address, emails) are NOT env vars — they live in
#  src/config/site.ts. This file is only for secrets and per-deployment URLs.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Postgres: Neon, Supabase, Railway, etc.) ── REQUIRED
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ── App URLs ── REQUIRED
# APP_URL is used for links inside emails (driver trip links, payment links).
# NEXT_PUBLIC_APP_URL is used client-side; falls back to SITE.url if unset.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BASE_URL="http://localhost:3000"

# ── Auth (NextAuth v5) ── REQUIRED
# Generate: openssl rand -base64 32
AUTH_SECRET=""
# Optional Google sign-in. Authorized redirect URI: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Stripe ── REQUIRED for booking payments
# Keys can also be stored per-client in Admin → Earnings → Payment Settings
# (encrypted with ENCRYPTION_KEY). Env values are the fallback.
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Webhook endpoint: {APP_URL}/api/stripe/webhook
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Encryption ── REQUIRED (encrypts Stripe keys stored in the database)
# Generate: openssl rand -hex 32   (must be 64 hex characters)
ENCRYPTION_KEY=""

# ── Email (Resend) ── REQUIRED
# Verify the client's sending domain in Resend first.
RESEND_API_KEY="re_..."
RESEND_FROM="Your Company <no-reply@example.com>"
EMAIL_FROM="Your Company <no-reply@example.com>"
CONTACT_FROM="Your Company <no-reply@example.com>"
# Where the public contact form is delivered
CONTACT_EMAIL="info@example.com"
CONTACT_PHONE="(000) 000-0000"

# ── Email (SMTP fallback via nodemailer) ── OPTIONAL
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# ── Google Maps ── REQUIRED for address autocomplete + distance pricing
# Browser key: restrict to the client's domain. Server key: restrict by IP/API.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=""
GOOGLE_MAPS_SERVER_KEY=""

# ── Cloudinary ── REQUIRED for photo uploads (vehicles, drivers, logo)
# Uploads are namespaced by SITE.slug so one Cloudinary account can serve
# every client if you prefer.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Web Push (admin + driver notifications) ── OPTIONAL
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@example.com"

# ── Cron ── REQUIRED in production
# vercel.json hits /api/internal/notifications/process every 5 minutes and
# /api/cron/purge-trash daily (empties the bookings trash after 7 days).
# Generate: openssl rand -hex 24
CRON_SECRET=""

# ── Flight status (RapidAPI AeroDataBox or similar) ── OPTIONAL
RAPIDAPI_KEY=""
RAPIDAPI_HOST=""

# ── Analytics (Plausible) ── OPTIONAL
PLAUSIBLE_SITE_ID=""
PLAUSIBLE_API_KEY=""

# ── Seed ── OPTIONAL (defaults: SITE.email.admin / ChangeMe123!)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# ── Dev ── OPTIONAL
ANALYZE="false"
